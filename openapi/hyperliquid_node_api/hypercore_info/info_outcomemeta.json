{
  "openapi": "3.0.0",
  "info": {
    "title": "Hyperliquid Node API",
    "version": "1.0.0",
    "description": "This is an API for interacting with Chainstack Hyperliquid node."
  },
  "servers": [
    {
      "url": "https://hyperliquid-mainnet.core.chainstack.com"
    }
  ],
  "paths": {
    "/mt_c524ad9781ae5dccd9ac6f5b0370e/info": {
      "post": {
        "tags": [
          "hyperliquid operations"
        ],
        "summary": "info (outcomeMeta)",
        "operationId": "infoOutcomeMeta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "default": "outcomeMeta",
                    "enum": [
                      "outcomeMeta"
                    ],
                    "description": "Request type to retrieve HIP-4 outcome market metadata"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Live HIP-4 outcome markets and categorical questions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outcomes": {
                      "type": "array",
                      "description": "Array of live outcome markets",
                      "items": {
                        "type": "object",
                        "properties": {
                          "outcome": {
                            "type": "integer",
                            "description": "Outcome id; combine with side index to derive the asset encoding"
                          },
                          "name": {
                            "type": "string",
                            "description": "Market name: \"Recurring\" for recurring binary markets, or the template name (for example, \"template:binaryPrice\") for deployer markets"
                          },
                          "description": {
                            "type": "string",
                            "description": "Pipe-separated key:value string. Recurring binaries carry class, underlying, expiry, targetPrice, and period; deployer markets carry their template parameters."
                          },
                          "sideSpecs": {
                            "type": "array",
                            "description": "Two-element array describing the YES (index 0) and NO (index 1) sides",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "description": "Side name (for example, 'Yes' or 'No')"
                                }
                              }
                            }
                          },
                          "quoteToken": {
                            "type": "string",
                            "description": "Token the outcome settles in, for example \"USDC\""
                          },
                          "venue": {
                            "type": "string",
                            "description": "Venue of the deployer that created the market; absent on recurring markets"
                          },
                          "deployerFeeScale": {
                            "type": "string",
                            "description": "Fee scale set for the deployer market, as a decimal string"
                          }
                        }
                      }
                    },
                    "questions": {
                      "type": "array",
                      "description": "Array of multi-outcome questions, recurring and deployer-created",
                      "items": {
                        "type": "object",
                        "properties": {
                          "question": {
                            "type": "integer",
                            "description": "Question id"
                          },
                          "name": {
                            "type": "string",
                            "description": "Question text"
                          },
                          "description": {
                            "type": "string",
                            "description": "Free-form description"
                          },
                          "fallbackOutcome": {
                            "type": "integer",
                            "description": "Outcome id used if none of the named outcomes matches"
                          },
                          "namedOutcomes": {
                            "type": "array",
                            "description": "Outcome ids for the named legs",
                            "items": {
                              "type": "integer"
                            }
                          },
                          "settledNamedOutcomes": {
                            "type": "array",
                            "description": "Outcome ids that have already settled",
                            "items": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    },
                    "deployers": {
                      "type": "array",
                      "description": "Market deployers and the accounts they delegate actions to",
                      "items": {
                        "type": "object",
                        "properties": {
                          "deployer": {
                            "type": "string",
                            "description": "Deployer address"
                          },
                          "venue": {
                            "type": "string",
                            "description": "Venue name"
                          },
                          "subDeployers": {
                            "type": "array",
                            "description": "Pairs of [action name, array of delegated addresses]",
                            "items": {
                              "type": "array"
                            }
                          }
                        }
                      }
                    },
                    "feeScale": {
                      "type": "string",
                      "description": "Global outcome market fee scale, as a decimal string"
                    }
                  },
                  "example": {
                    "outcomes": [
                      {
                        "outcome": 33246,
                        "name": "Recurring",
                        "description": "class:priceBinary|underlying:BTC|expiry:20261113-0600|targetPrice:73567|period:1d",
                        "sideSpecs": [
                          {
                            "name": "Yes"
                          },
                          {
                            "name": "No"
                          }
                        ],
                        "quoteToken": "USDC"
                      },
                      {
                        "outcome": 32843,
                        "name": "template:binaryPrice",
                        "description": "perp:xyz:SNDK|priceDescription:xyz:SNDK-USDC perp mark|seconds:60|threshold:977.77|time:20261112-2100",
                        "sideSpecs": [
                          {
                            "name": "template:Yes"
                          },
                          {
                            "name": "template:No"
                          }
                        ],
                        "quoteToken": "USDC",
                        "venue": "out",
                        "deployerFeeScale": "1.0"
                      }
                    ],
                    "questions": [
                      {
                        "question": 620,
                        "name": "template:sportsContestResult",
                        "description": "competition:UEFA Nations League|contestType:Match|countedPlay:regulation time, 90 minutes plus stoppage time|officialSource:Union of European Football Associations|participantA:Bulgaria|participantB:Iceland|resolutionDeadline:20261120-1945|scheduledStart:20261113-1945|season:2026/27|sport:Soccer|stage:C, Matchday 5",
                        "fallbackOutcome": 29101,
                        "namedOutcomes": [
                          29102,
                          29103,
                          29104
                        ],
                        "settledNamedOutcomes": []
                      }
                    ],
                    "deployers": [
                      {
                        "deployer": "0x08e9c89f46dccee91bdb85c6532eb93a4c335efe",
                        "venue": "skew",
                        "subDeployers": [
                          [
                            "settleOutcome",
                            [
                              "0x1c867861e0cffb0eba07d9d94f716189c130dac6"
                            ]
                          ]
                        ]
                      }
                    ],
                    "feeScale": "1.0"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
