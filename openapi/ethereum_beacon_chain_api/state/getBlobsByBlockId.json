{
  "openapi": "3.0.0",
  "info": {
    "title": "Ethereum Beacon Blobs API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://ethereum-mainnet.core.chainstack.com"
    }
  ],
  "paths": {
    "/beacon/mt_c524ad9781ae5dccd9ac6f5b0370e/eth/v1/beacon/blobs/{block_id}": {
      "get": {
        "summary": "Get blobs by block_id",
        "operationId": "getBlobsByBlockId",
        "parameters": [
          {
            "name": "block_id",
            "in": "path",
            "description": "Block identifier: 'head', 'genesis', 'finalized', a slot number, or a hex-encoded block root with the 0x prefix.",
            "required": true,
            "schema": {
              "type": "string",
              "default": "head"
            }
          },
          {
            "name": "versioned_hashes",
            "in": "query",
            "description": "Blob versioned hashes of the blobs to return. Returns all blobs in the block if not specified.",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Blobs successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlobsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Block not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlobsResponse": {
        "type": "object",
        "properties": {
          "execution_optimistic": {
            "type": "boolean"
          },
          "finalized": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Blob as a hex string"
            }
          }
        },
        "required": [
          "execution_optimistic",
          "finalized",
          "data"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
